   "vo": "vo_05.mp3",
   "voice_id": "kGOig3GPePLxobJGHo2M"
  },
  {
   "speaker": "bill",
   "text": "Osh yeyildi, endi duo qilamiz. Yoshlarga baxt, ota-onaga sabr, mahallaga tinchlik bersin.",
   "mood": "warm",
   "img": "06.jpg",
   "elements": [
